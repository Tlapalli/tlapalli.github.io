---
import '@fontsource-variable/unbounded'
import '@fontsource-variable/inter'
import '../styles/studio.css'
import { Image } from 'astro:assets'
import { href } from '../href'
import mark from '../assets/brand/tlapalli.png'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const ogUrl = new URL(href('/og.jpg'), Astro.site)
const nav = [
  { label: 'Games', href: href('/#games') },
  { label: 'Ollin engine', href: href('/ollin/') },
  { label: 'Docs', href: href('/docs/getting-started/') },
  { label: 'Studio', href: href('/#studio') },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120d17" />
    <link rel="icon" href={href('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={href('/')} aria-label="Tlapalli home">
        <Image src={mark} alt="" class="brand-mark" width={64} height={64} />
        <span>Tlapalli</span>
      </a>
      <nav aria-label="Main">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="topbar-gh" href="https://github.com/Tlapalli" aria-label="Tlapalli on GitHub">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="greca" aria-hidden="true"></div>
      <div class="footer-inner">
        <div>
          <a class="brand" href={href('/')}><Image src={mark} alt="" class="brand-mark" width={64} height={64} /><span>Tlapalli</span></a>
          <p>A small game studio, proudly made in Mexico. Games and tools painted in red and black ink.</p>
        </div>
        <div class="footer-links">
          <a href={href('/ollin/')}>Ollin engine</a>
          <a href={href('/docs/getting-started/')}>Docs</a>
          <a href="https://github.com/Tlapalli">GitHub</a>
          <a href="https://www.npmjs.com/package/@tlapalli/ollin">npm</a>
        </div>
      </div>
      <p class="footer-legal">© {new Date().getFullYear()} Tlapalli. Ollin is open source under the MIT license.</p>
    </footer>
  </body>
</html>
